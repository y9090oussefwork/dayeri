  header{
    display:flex;align-items:center;justify-content:space-between;gap:12px;
    padding:14px 0 18px;border-bottom:2px solid var(--line);margin-bottom:22px;
  }
  .brand{display:flex;align-items:center;gap:10px;min-width:0}
  .brand b{
    font-family:var(--disp);font-weight:800;color:var(--paint);
    font-size:1.25rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  }
  .toggle{
    flex:none;appearance:none;border:1px solid var(--line);background:var(--panel-2);
    color:var(--ink);font-family:inherit;font-size:.82rem;font-weight:600;
    padding:8px 14px;border-radius:999px;cursor:pointer;
  }
  .toggle:hover{border-color:var(--paint)}
  .toggle:active{transform:translateY(1px)}
  h1{
    font-family:var(--disp);font-weight:800;color:var(--paint);
    font-size:1.5rem;margin:0 0 4px;line-height:1.35;
  }
  .meta{color:var(--ink-dim);font-size:.85rem;margin:0 0 26px}
  h2{
    font-family:var(--disp);font-weight:700;color:var(--paint);
    font-size:1.08rem;margin:30px 0 10px;
  }
  h2:first-of-type{margin-top:0}
  p{margin:0 0 12px;font-size:.95rem;color:var(--ink)}
  ul{margin:0 0 12px;padding-inline-start:22px}
  li{margin:0 0 6px;font-size:.95rem}
  .card{
    background:var(--panel);border:1px solid var(--line);border-radius:12px;
    padding:14px 16px;margin:0 0 14px;
  }
  .muted{color:var(--ink-dim);font-size:.85rem}
  code{
    background:var(--panel-2);border:1px solid var(--line);border-radius:5px;
    padding:1px 6px;font-size:.85em;direction:ltr;unicode-bidi:embed;
  }
  a{color:var(--paint)}
  hr{border:none;border-top:1px solid var(--line);margin:26px 0}
  footer{color:var(--ink-dim);font-size:.8rem;margin-top:30px}
  footer .foot{display:block;margin-top:8px;line-height:2}
  [dir="ltr"] ul{padding-inline-start:22px}
  footer .foot{display:block;margin-top:8px;line-height:2}
  a.toggle{text-decoration:none}
  ol{margin:0 0 12px;padding-inline-start:22px}
  .play{display:inline-block;margin:6px 0 0;padding:10px 22px;border-radius:999px;background:var(--paint);color:#1b1d33;font-family:var(--disp);font-weight:800;text-decoration:none}
